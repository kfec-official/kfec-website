---
import { url } from '../lib/utils';
import site from '../data/site.json';

const nav = [
  { label: 'ABOUT', href: '/about', ko: '학회 소개' },
  { label: 'RESEARCH', href: '/research', ko: '리서치' },
  { label: 'ACHIEVEMENTS', href: '/awards', ko: '수상·Alumni 현황' },
  { label: 'RECRUITMENT', href: '/join', ko: '가입 안내' },
];

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname.replace(base, '').replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  !href.includes('#') && (current === href || current.startsWith(`${href}/`));
---

<div class="bg-navy-dark text-on-navy on-dark">
  <div class="container-page flex h-9 items-center justify-between text-xs">
    <p>{site.affiliation}</p>
    <ul class="flex items-center gap-4">
      <li>
        <a href={site.cafeUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white hover:underline underline-offset-4">
          네이버 카페<span class="sr-only"> (새 창)</span>
        </a>
      </li>
      <li aria-hidden="true" class="h-3 w-px bg-white/25"></li>
      <li>
        <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white hover:underline underline-offset-4">
          Instagram<span class="sr-only"> (새 창)</span>
        </a>
      </li>
    </ul>
  </div>
</div>

<header class="sticky top-0 z-50 border-b border-line bg-white">
  <div class="container-page flex h-[4.5rem] items-center justify-between">
    <a href={url('/')} class="flex items-center gap-3">
      <img src={url('/images/kfec-mark.png')} alt="KFEC 홈" width="97" height="28" class="h-7 w-auto" />
      <span class="hidden border-l border-line pl-3 leading-tight sm:block">
        <span class="block text-[0.8125rem] font-bold text-ink">경성대학교 금융투자학회</span>
        <span class="block font-display text-[0.6875rem] tracking-[0.08em] text-muted" lang="en">Kyungsung Finance &amp; Economics Club</span>
      </span>
    </a>

    <nav aria-label="주 메뉴" class="hidden lg:block">
      <ul class="flex items-center gap-2">
        {nav.map((item) => (
          <li>
            <a
              href={url(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'block px-3 py-2 font-display text-[0.8125rem] font-bold tracking-[0.12em] transition-colors hover:text-navy',
                isActive(item.href)
                  ? 'text-navy underline decoration-2 underline-offset-[12px]'
                  : 'text-ink',
              ]}
              lang="en"
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      type="button"
      id="menu-toggle"
      class="-mr-2 inline-flex h-11 w-11 items-center justify-center text-navy lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only" data-label>메뉴 열기</span>
      <svg data-icon="open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
      <svg data-icon="close" class="hidden" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" aria-label="모바일 메뉴" class="hidden border-t border-line bg-white lg:hidden">
    <ul class="container-page py-2">
      {nav.map((item) => (
        <li class="border-b border-line last:border-b-0">
          <a
            href={url(item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'flex items-baseline justify-between py-3.5 font-display text-[0.9375rem] font-bold tracking-[0.12em]',
              isActive(item.href) ? 'text-navy' : 'text-ink',
            ]}
          ><span lang="en">{item.label}</span><span class="font-sans text-sm font-normal tracking-normal text-muted">{item.ko}</span></a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const button = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (button && menu) {
    const label = button.querySelector('[data-label]');
    const iconOpen = button.querySelector('[data-icon="open"]');
    const iconClose = button.querySelector('[data-icon="close"]');
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('hidden', !open);
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
      if (label) label.textContent = open ? '메뉴 닫기' : '메뉴 열기';
    };
    button.addEventListener('click', () => {
      setOpen(button.getAttribute('aria-expanded') !== 'true');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        button.focus();
      }
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
