---
import type { Alumni } from '../lib/utils';

interface Props {
  list: Alumni[];
  caption: string;
}
const { list, caption } = Astro.props;
const showMember = list.some((a) => a.member && a.member.trim() !== '');
---

{list.length === 0 ? (
  <p class="border border-line bg-white px-6 py-10 text-center text-muted">등록된 현황이 없습니다.</p>
) : (
  <div class="overflow-x-auto border border-line bg-white" role="region" aria-label={caption} tabindex="0">
    <table class="w-full min-w-[640px] border-collapse text-left text-sm">
      <caption class="sr-only">{caption}</caption>
      <thead>
        <tr class="border-b-2 border-navy bg-paper">
          <th scope="col" class="w-24 px-5 py-3 font-bold">연도</th>
          <th scope="col" class="px-5 py-3 font-bold">구분</th>
          <th scope="col" class="px-5 py-3 font-bold">기관·기업</th>
          <th scope="col" class="px-5 py-3 font-bold">부서·직무</th>
          {showMember && <th scope="col" class="px-5 py-3 font-bold">학회원</th>}
        </tr>
      </thead>
      <tbody>
        {list.map((a) => (
          <tr class="border-b border-line last:border-b-0">
            <td class="num px-5 py-4 font-display font-bold text-navy">{a.year}</td>
            <td class="px-5 py-4">
              <span class="inline-block border border-navy px-2 py-0.5 text-xs font-bold text-navy">{a.status}</span>
            </td>
            <th scope="row" class="px-5 py-4 font-bold text-ink">{a.organization}</th>
            <td class="px-5 py-4">{a.role}</td>
            {showMember && <td class="px-5 py-4 text-muted">{a.member}</td>}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}
