---
// 여의도 금융가 야경 스카이라인 일러스트 (직접 그린 단순화 도형, 사진 아님)
// 앞줄 왼쪽부터: 63빌딩 · FKI타워 · IFC 서울(3개 동) · 파크원(2개 동) 을 모티브로 한 실루엣
const W = 700;
const H = 480;
const GROUND = 384;

const STROKE = '#C9D6EA';
const FRONT = '#042A5F'; // 앞 건물
const MID = '#08326F'; // 중간 건물
const FAR = '#0D4592'; // 먼 건물 (배경보다 살짝 밝게)
const GRID = 'rgba(201, 214, 234, 0.16)';
const LIGHT = '#EAF0F8';

type B = { id: string; d: string; x1: number; x2: number; top: number; cols: number; rows: number };

const front: B[] = [
  // 63빌딩: 위로 갈수록 부드럽게 좁아지는 형태
  { id: 'b63', d: `M44 ${GROUND} Q53 250 66 108 L114 108 Q127 250 136 ${GROUND} Z`, x1: 44, x2: 136, top: 108, cols: 5, rows: 22 },
  // FKI타워: 기울어진 지붕
  { id: 'bfki', d: `M162 ${GROUND} L162 160 L226 142 L226 ${GROUND} Z`, x1: 162, x2: 226, top: 142, cols: 5, rows: 20 },
  // IFC One
  { id: 'bifc1', d: `M248 ${GROUND} L248 138 L310 112 L310 ${GROUND} Z`, x1: 248, x2: 310, top: 112, cols: 5, rows: 24 },
  // IFC Two
  { id: 'bifc2', d: `M318 ${GROUND} L318 186 L362 168 L362 ${GROUND} Z`, x1: 318, x2: 362, top: 168, cols: 4, rows: 18 },
  // IFC Three
  { id: 'bifc3', d: `M370 ${GROUND} L370 214 L410 200 L410 ${GROUND} Z`, x1: 370, x2: 410, top: 200, cols: 3, rows: 15 },
  // 콘래드 호텔 모티브 (낮은 동)
  { id: 'bcon', d: `M418 ${GROUND} L418 240 L466 240 L466 ${GROUND} Z`, x1: 418, x2: 466, top: 240, cols: 4, rows: 11 },
  // 파크원 A
  { id: 'bp1', d: `M486 ${GROUND} L486 54 L538 54 L538 ${GROUND} Z`, x1: 486, x2: 538, top: 54, cols: 4, rows: 30 },
  // 파크원 B
  { id: 'bp2', d: `M552 ${GROUND} L552 90 L600 90 L600 ${GROUND} Z`, x1: 552, x2: 600, top: 90, cols: 4, rows: 27 },
  // 오른쪽 오피스
  { id: 'bo1', d: `M616 ${GROUND} L616 232 L652 222 L652 ${GROUND} Z`, x1: 616, x2: 652, top: 222, cols: 3, rows: 12 },
  { id: 'bo2', d: `M658 ${GROUND} L658 276 L692 276 L692 ${GROUND} Z`, x1: 658, x2: 692, top: 276, cols: 3, rows: 8 },
];

// 중간 줄 건물 [x, top, w]
const mid: [number, number, number][] = [
  [0, 286, 40], [138, 250, 26], [226, 228, 24], [300, 262, 22], [404, 214, 20],
  [462, 196, 28], [596, 178, 26], [640, 250, 40],
];
// 먼 건물 [x, top, w]
const far: [number, number, number][] = [
  [0, 248, 30], [28, 300, 30], [100, 270, 36], [150, 230, 30], [200, 268, 40], [236, 196, 22],
  [290, 240, 36], [340, 150, 22], [380, 232, 36], [440, 176, 30], [470, 262, 30], [520, 214, 34],
  [580, 140, 22], [612, 200, 30], [650, 238, 50],
];

// 결정적(매번 같은) 의사난수 — 불 켜진 창문 배치용
const rand = (n: number) => {
  const x = Math.sin(n * 12.9898 + 78.233) * 43758.5453;
  return x - Math.floor(x);
};

const lit = (b: B, bi: number) => {
  const out: { x: number; y: number; w: number; h: number; o: number }[] = [];
  const cw = (b.x2 - b.x1) / b.cols;
  const rh = (GROUND - b.top) / b.rows;
  for (let r = 1; r < b.rows; r++) {
    for (let c = 0; c < b.cols; c++) {
      const v = rand(bi * 1000 + r * 31 + c * 7);
      if (v < 0.17) {
        out.push({ x: b.x1 + c * cw + 2, y: b.top + r * rh + 1.5, w: cw - 4, h: Math.max(rh - 3.5, 2), o: 0.35 + rand(v * 999) * 0.5 });
      }
    }
  }
  return out;
};

const gridLines = (b: B) => {
  const rh = (GROUND - b.top) / b.rows;
  const cw = (b.x2 - b.x1) / b.cols;
  return {
    h: Array.from({ length: b.rows - 1 }, (_, i) => b.top + rh * (i + 1)),
    v: Array.from({ length: b.cols - 1 }, (_, i) => b.x1 + cw * (i + 1)),
  };
};

// 한강 물결 [y, x, w]
const waves: [number, number, number][] = [
  [398, 24, 190], [398, 260, 120], [398, 430, 160], [398, 620, 60],
  [414, 70, 150], [414, 300, 230], [414, 580, 90],
  [430, 10, 110], [430, 180, 170], [430, 420, 190],
  [446, 110, 230], [446, 400, 130], [446, 580, 100],
  [462, 40, 130], [462, 250, 200],
];
---

<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="skyline-title" class="block h-auto w-full">
  <title id="skyline-title">여의도 금융가 야경 스카이라인 일러스트</title>
  <defs>
    {front.map((b) => <clipPath id={`clip-${b.id}`}><path d={b.d} /></clipPath>)}
    <clipPath id="clip-river"><rect x="0" y={GROUND} width={W} height={H - GROUND} /></clipPath>
  </defs>

  <!-- 달 -->
  <circle cx="420" cy="78" r="26" fill="none" stroke={STROKE} stroke-opacity="0.5" stroke-width="1.2" />
  <circle cx="420" cy="78" r="34" fill="none" stroke={STROKE} stroke-opacity="0.14" stroke-width="1" />

  <g id="kfec-skyline">
    <!-- 먼 건물 -->
    <g fill={FAR}>
      {far.map(([x, top, w]) => <rect x={x} y={top} width={w} height={GROUND - top} />)}
    </g>
    <!-- 중간 건물 -->
    <g fill={MID}>
      {mid.map(([x, top, w]) => <rect x={x} y={top} width={w} height={GROUND - top} />)}
    </g>

    <!-- 앞 건물 -->
    {front.map((b, bi) => {
      const g = gridLines(b);
      return (
        <g>
          <path d={b.d} fill={FRONT} />
          <g clip-path={`url(#clip-${b.id})`}>
            <g stroke={GRID} stroke-width="0.8">
              {g.h.map((y) => <line x1={b.x1 - 20} x2={b.x2 + 20} y1={y} y2={y} />)}
              {g.v.map((x) => <line x1={x} x2={x} y1={b.top - 40} y2={GROUND} />)}
            </g>
            <g fill={LIGHT}>
              {lit(b, bi).map((w) => <rect x={w.x} y={w.y} width={w.w} height={w.h} opacity={w.o.toFixed(2)} />)}
            </g>
          </g>
          <path d={b.d} fill="none" stroke={STROKE} stroke-width="1.3" stroke-linejoin="round" />
        </g>
      );
    })}

    <!-- 63빌딩 꼭대기 -->
    <rect x="76" y="96" width="28" height="12" fill={FRONT} stroke={STROKE} stroke-width="1.2" />
    <line x1="90" x2="90" y1="74" y2="96" stroke={STROKE} stroke-width="1.2" />
    <circle cx="90" cy="72" r="1.8" fill={LIGHT} />

    <!-- 파크원 외부 프레임 -->
    <g stroke={STROKE} stroke-width="2.4" stroke-linecap="square">
      <line x1="486" x2="486" y1="32" y2={GROUND} />
      <line x1="538" x2="538" y1="32" y2={GROUND} />
      <line x1="486" x2="538" y1="32" y2="32" />
      <line x1="552" x2="552" y1="70" y2={GROUND} />
      <line x1="600" x2="600" y1="70" y2={GROUND} />
      <line x1="552" x2="600" y1="70" y2="70" />
    </g>
    <!-- 항공 장애등 -->
    <circle cx="512" cy="26" r="1.8" fill={LIGHT} />
    <circle cx="576" cy="64" r="1.8" fill={LIGHT} />
  </g>

  <!-- 강변 -->
  <line x1="0" x2={W} y1={GROUND} y2={GROUND} stroke={STROKE} stroke-width="1.4" />

  <!-- 물에 비친 모습 -->
  <g clip-path="url(#clip-river)" opacity="0.2">
    <use href="#kfec-skyline" transform={`translate(0 ${GROUND * 2}) scale(1 -1)`} />
  </g>

  <!-- 물결 -->
  <g stroke={STROKE} stroke-linecap="round">
    {waves.map(([y, x, w], i) => (
      <line x1={x} x2={x + w} y1={y} y2={y} stroke-width="1" stroke-opacity={(0.55 - (i % 3) * 0.13).toFixed(2)} stroke-dasharray={i % 2 ? '20 9' : '44 12'} />
    ))}
  </g>
</svg>
