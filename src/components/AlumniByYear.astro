---
import { countAlumniByStatus, type Alumni } from '../lib/utils';

interface Props {
  list: Alumni[];
}
const { list } = Astro.props;
const counts = countAlumniByStatus(list);

// 이미 최신 연도순으로 정렬된 목록을 연도별로 묶습니다.
const groups: { year: string; items: Alumni[] }[] = [];
for (const a of list) {
  const year = String(a.year).trim();
  const last = groups[groups.length - 1];
  if (last && last.year === year) last.items.push(a);
  else groups.push({ year, items: [a] });
}
---

{counts.length > 0 && (
  <dl class="mb-10 grid grid-cols-2 gap-3 sm:flex sm:flex-wrap">
    {counts.map((c) => (
      <div class="border border-line bg-white px-5 py-5 sm:min-w-44">
        <dt class="text-sm font-medium text-muted">{c.status}</dt>
        <dd class="num mt-1 font-display text-3xl font-bold text-navy">
          {c.count}<span class="ml-1 font-sans text-base text-ink">명</span>
        </dd>
      </div>
    ))}
  </dl>
)}

{groups.length === 0 ? (
  <p class="border border-line bg-white px-6 py-10 text-center text-muted">등록된 현황이 없습니다.</p>
) : (
  <div class="space-y-10">
    {groups.map((g) => (
      <section class="grid gap-4 md:grid-cols-[9rem_1fr] md:gap-8">
        <h3 class="num font-display text-4xl font-black text-navy md:pt-3">
          {g.year}<span class="sr-only">년 Alumni·실습 현황</span>
        </h3>
        <ul class="divide-y divide-line border-t-2 border-navy border-b border-b-line bg-white">
          {g.items.map((a) => (
            <li class="flex items-center justify-between gap-6 px-5 py-5">
              <p class="font-bold text-ink">{a.organization}</p>
              <p class="shrink-0">
                <span class="sr-only">구분: </span>
                <span class="inline-block border border-navy px-3 py-1 text-sm font-bold text-navy">{a.status}</span>
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
)}
