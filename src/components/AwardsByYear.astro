---
import type { Award } from '../lib/utils';

interface Props {
  awards: Award[];
  headingLevel?: 'h2' | 'h3';
}
const { awards, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;

// 이미 최신 연도순으로 정렬된 목록을 연도별로 묶습니다.
const groups: { year: string; items: Award[] }[] = [];
for (const a of awards) {
  const year = String(a.year).trim();
  const last = groups[groups.length - 1];
  if (last && last.year === year) last.items.push(a);
  else groups.push({ year, items: [a] });
}
---

{groups.length === 0 ? (
  <p class="border border-line bg-white px-6 py-10 text-center text-muted">등록된 수상 내역이 없습니다.</p>
) : (
  <div class="space-y-10">
    {groups.map((g) => (
      <section class="grid gap-4 md:grid-cols-[9rem_1fr] md:gap-8">
        <Heading class="num font-display text-4xl font-black text-navy md:pt-3">
          {g.year}<span class="sr-only">년 수상 내역</span>
        </Heading>
        <ul class="divide-y divide-line border-t-2 border-navy border-b border-b-line bg-white">
          {g.items.map((a) => (
            <li class="flex flex-col gap-2 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
              <div>
                <p class="font-bold text-ink">{a.competition}</p>
                <p class="mt-0.5 text-sm text-muted">{a.host}</p>
              </div>
              <p class="shrink-0">
                <span class="sr-only">수상 등급: </span>
                <span class="inline-block border border-navy px-3 py-1 text-sm font-bold text-navy">{a.prize}</span>
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
)}
