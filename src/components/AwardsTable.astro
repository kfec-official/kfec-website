---
import type { Award } from '../lib/utils';

interface Props {
  awards: Award[];
  caption: string;
}
const { awards, caption } = Astro.props;
---

{awards.length === 0 ? (
  <p class="border border-line bg-white px-6 py-10 text-center text-muted">등록된 수상 내역이 없습니다.</p>
) : (
  <div class="overflow-x-auto border border-line bg-white" role="region" aria-label={caption} tabindex="0">
    <table class="w-full min-w-[640px] border-collapse text-left text-sm">
      <caption class="sr-only">{caption}</caption>
      <thead>
        <tr class="border-b-2 border-navy bg-paper">
          <th scope="col" class="w-24 px-5 py-3 font-bold">연도</th>
          <th scope="col" class="px-5 py-3 font-bold">대회명 · 주최</th>
          <th scope="col" class="px-5 py-3 font-bold">수상 등급</th>
          <th scope="col" class="px-5 py-3 font-bold">참가팀</th>
        </tr>
      </thead>
      <tbody>
        {awards.map((a) => (
          <tr class="border-b border-line last:border-b-0">
            <td class="num px-5 py-4 font-display font-bold text-navy">{a.year}</td>
            <th scope="row" class="px-5 py-4 font-normal">
              <span class="block font-bold text-ink">{a.competition}</span>
              <span class="mt-0.5 block text-muted">{a.host}</span>
            </th>
            <td class="px-5 py-4 font-medium">{a.prize}</td>
            <td class="px-5 py-4 text-muted">{a.team}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
)}
