---
import { url } from '../lib/utils';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="bg-navy text-white on-dark">
  <div class="container-page py-12 sm:py-16">
    <nav aria-label="현재 위치" class="text-xs text-on-navy">
      <ol class="flex items-center gap-2">
        <li><a href={url('/')} class="hover:text-white hover:underline underline-offset-4">홈</a></li>
        <li aria-hidden="true">/</li>
        <li><span aria-current="page" class="font-display tracking-[0.12em] uppercase" lang="en">{eyebrow}</span></li>
      </ol>
    </nav>
    <h1 class="mt-6 font-serif text-3xl font-bold sm:text-[2.75rem] sm:leading-tight">{title}</h1>
    <div class="mt-5 h-0.5 w-12 bg-white"></div>
    {lead && <p class="mt-5 max-w-2xl text-base leading-7 text-on-navy sm:text-lg">{lead}</p>}
    <slot />
  </div>
</section>
