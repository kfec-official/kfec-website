---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<section class="border-b border-line bg-white">
  <div class="container-page py-12 sm:py-16">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-3 font-serif text-3xl font-bold text-ink sm:text-4xl">{title}</h1>
    {lead && <p class="mt-4 max-w-2xl text-base leading-7 text-muted sm:text-lg">{lead}</p>}
    <slot />
  </div>
</section>
