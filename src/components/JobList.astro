---
import { formatDate, isDateString, isPlaceholder, type Job } from '../lib/utils';

interface Props {
  jobs: Job[];
  headingLevel?: 'h2' | 'h3';
}
const { jobs, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;

// 빌드 시점 기준 마감 여부 (방문 시점 기준으로는 아래 스크립트가 다시 확인)
const todayKst = new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10);
const isClosed = (d: string) => isDateString(d) && d.trim() < todayKst;
const sorted = [...jobs.filter((j) => !isClosed(j.deadline)), ...jobs.filter((j) => isClosed(j.deadline))];
---

{sorted.length === 0 ? (
  <p class="border border-line bg-white px-6 py-10 text-center text-muted">등록된 공고가 없습니다.</p>
) : (
  <ul class="divide-y divide-line border border-line bg-white" data-job-list>
    {sorted.map((job) => {
      const closed = isClosed(job.deadline);
      const hasLink = /^https?:\/\//.test(job.url.trim());
      return (
        <li
          class:list={['grid gap-4 px-5 py-5 sm:grid-cols-[1fr_auto] sm:items-center sm:px-6', closed && 'is-closed']}
          data-deadline={isDateString(job.deadline) ? job.deadline.trim() : undefined}
        >
          <div>
            <p class="flex flex-wrap items-center gap-2 text-xs font-medium">
              <span class="border border-navy px-2 py-0.5 font-bold text-navy">{job.type}</span>
              <span class="text-muted">{job.company}</span>
              <span data-closed-badge class:list={['bg-muted px-2 py-0.5 font-bold text-white', !closed && 'hidden']}>마감</span>
            </p>
            <Heading class="mt-2 font-sans text-base font-bold leading-snug text-ink sm:text-lg">{job.title}</Heading>
            {job.note && <p class="mt-1 text-sm text-muted">{job.note}</p>}
          </div>
          <div class="flex items-center justify-between gap-4 sm:justify-end">
            <p class="text-sm">
              <span class="text-muted">마감일 </span>
              <span class="num font-bold">{isDateString(job.deadline) ? formatDate(job.deadline.trim()) : job.deadline}</span>
            </p>
            {hasLink ? (
              <a href={job.url.trim()} target="_blank" rel="noopener noreferrer" class="btn-outline shrink-0 px-4 py-2">
                공고 보기<span class="sr-only"> — {job.company} {job.title} (새 창)</span>
              </a>
            ) : (
              <span class="shrink-0 border border-dashed border-line px-4 py-2 text-sm text-muted">
                {isPlaceholder(job.url) ? job.url : '링크 없음'}
              </span>
            )}
          </div>
        </li>
      );
    })}
  </ul>
)}

<style>
  .is-closed {
    background: var(--color-paper);
  }
  .is-closed h2,
  .is-closed h3 {
    color: var(--color-muted);
  }
</style>

<script>
  // 방문한 날짜(한국 시간) 기준으로 마감된 공고를 표시하고 목록 맨 뒤로 보냅니다.
  const today = new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10);
  document.querySelectorAll<HTMLUListElement>('[data-job-list]').forEach((list) => {
    const items = Array.from(list.querySelectorAll<HTMLLIElement>(':scope > li'));
    const closed: HTMLLIElement[] = [];
    for (const li of items) {
      const d = li.dataset.deadline;
      const isClosed = !!d && d < today;
      li.classList.toggle('is-closed', isClosed);
      li.querySelector('[data-closed-badge]')?.classList.toggle('hidden', !isClosed);
      if (isClosed) closed.push(li);
    }
    closed.forEach((li) => list.appendChild(li));
  });
</script>
