---
import { url } from '../lib/utils';

interface Props {
  title: string;
  /** 한 줄 한글 설명 */
  desc?: string;
  id?: string;
  moreHref?: string;
  moreLabel?: string;
}
const { title, desc, id, moreHref, moreLabel = 'View All' } = Astro.props;
---

<div class="flex flex-wrap items-end justify-between gap-4 border-b-2 border-navy pb-4">
  <div>
    <h2 id={id} lang="en" class="font-display text-[1.75rem] font-bold leading-tight text-ink sm:text-[2.125rem]">{title}</h2>
    {desc && <p class="mt-2 text-sm text-muted">{desc}</p>}
  </div>
  {moreHref && (
    <a href={url(moreHref)} lang="en" class="font-display text-sm font-bold tracking-wide text-navy hover:underline underline-offset-4">
      {moreLabel}<span class="sr-only"> — {title}</span> →
    </a>
  )}
</div>
