---
import activities from '../data/activities.json';
---

<ol>
  {activities.map((a, i) => (
    <li class="grid grid-cols-[3rem_1fr] items-baseline gap-x-4 gap-y-1 border-b border-line py-5 md:grid-cols-[4.5rem_16rem_1fr] md:gap-x-6">
      <span class="num font-display text-2xl font-black text-navy" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
      <h3 lang="en" class="font-display text-xl font-bold text-ink">{a.title}</h3>
      <p class="col-start-2 text-sm text-muted md:col-start-auto md:text-base">{a.desc}</p>
    </li>
  ))}
</ol>
