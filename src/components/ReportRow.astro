---
import type { CollectionEntry } from 'astro:content';
import { getReportPdf } from '../lib/utils';

interface Props {
  report: CollectionEntry<'reports'>;
  headingLevel?: 'h2' | 'h3';
}
const { report, headingLevel = 'h3' } = Astro.props;
const { title, category } = report.data;
const Heading = headingLevel;
const pdf = getReportPdf(report);
---

<article class="grid grid-cols-[1fr_auto] items-center gap-x-6 gap-y-1 px-5 py-5 sm:grid-cols-[6.5rem_1fr_auto] sm:px-6">
  <p class="col-span-2 text-xs font-bold text-navy sm:col-span-1 sm:text-sm">{category}</p>
  <Heading class="font-serif text-lg font-bold text-ink sm:text-xl">{title}</Heading>
  {pdf ? (
    <a href={pdf} download={`KFEC_${category}_${title}.pdf`} class="btn-outline shrink-0 px-4 py-2.5">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12m0 0l-5-5m5 5l5-5M5 21h14" /></svg>
      PDF<span class="sr-only"> 다운로드 — {title} {category}</span>
    </a>
  ) : (
    <span class="shrink-0 px-4 py-2.5 text-sm text-muted">PDF 준비 중</span>
  )}
</article>
