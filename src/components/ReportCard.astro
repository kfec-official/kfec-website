---
import type { CollectionEntry } from 'astro:content';
import OpinionBadge from './OpinionBadge.astro';
import { url, formatDate, isoDate } from '../lib/utils';

interface Props {
  report: CollectionEntry<'reports'>;
  headingLevel?: 'h2' | 'h3';
}
const { report, headingLevel = 'h3' } = Astro.props;
const { title, category, date, summary, opinion, team } = report.data;
const Heading = headingLevel;
const iso = isoDate(date);
---

<article
  class="group relative flex h-full flex-col border border-line bg-white p-6 transition-colors hover:border-navy"
  data-category={category}
>
  <p class="flex items-center gap-2 text-xs font-medium text-muted">
    <span class="font-bold text-navy">{category}</span>
    <span aria-hidden="true">·</span>
    {iso ? <time datetime={iso} class="num">{formatDate(date)}</time> : <span>{formatDate(date)}</span>}
  </p>
  <Heading class="mt-3 font-serif text-lg font-bold leading-snug text-ink">
    <a href={url(`/research/${report.id}/`)} class="after:absolute after:inset-0 group-hover:text-navy">
      {title}
    </a>
  </Heading>
  <p class="mt-3 line-clamp-2 text-sm leading-6 text-muted">{summary}</p>
  <div class="mt-auto pt-5">
    <div class="flex items-center justify-between gap-3 border-t border-line pt-4">
      <OpinionBadge opinion={opinion} />
      <span class="text-xs text-muted"><span class="sr-only">작성: </span>{team}</span>
    </div>
  </div>
</article>
