---
import type { Achievement } from '../lib/utils';
import site from '../data/site.json';

interface Props {
  groups: { year: string; items: Achievement[] }[];
  headingLevel?: 'h2' | 'h3';
}
const { groups, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;

// "네트워크(BUFF)"처럼 한글 바로 뒤의 괄호 앞에서 줄이 바뀌지 않도록 (U+2060 단어 결합자)
const keep = (t: string) => t.replace(/([가-힣])\(/g, '$1\u2060(');

// 창립 연도 칸에 창립 표시를 따로 붙입니다 (site.json 의 founded, 예: "2025.09.01")
const foundedYear = site.founded?.slice(0, 4);
---

{groups.length === 0 ? (
  <p class="border border-line bg-white px-6 py-10 text-center text-muted">등록된 내용이 없습니다.</p>
) : (
  <div class="space-y-12">
    {groups.map((g) => (
      <section class="grid gap-4 md:grid-cols-[9rem_1fr] md:gap-8">
        <Heading class="num font-display text-4xl font-black text-navy md:pt-3">
          {g.year}<span class="sr-only">년 Achievements</span>
        </Heading>
        <ul class="divide-y divide-line border-t-2 border-navy border-b border-b-line bg-white">
          {g.items.map((a) => (
            <li class="grid grid-cols-1 gap-y-1.5 sm:items-center sm:gap-y-2 px-5 py-5 sm:grid-cols-[5.5rem_1fr_auto] sm:gap-x-6">
              <p class="text-xs font-bold text-navy"><span class="sr-only">분류: </span>{a.category}</p>
              <div>
                <p class="font-bold text-ink">{keep(a.title)}</p>
                {a.host && <p class="mt-0.5 text-sm text-muted">{a.host}</p>}
              </div>
              {a.result ? (
                <p class="mt-1 sm:mt-0 sm:shrink-0">
                  <span class="inline-block border border-navy px-3 py-1 text-sm font-bold text-navy">{a.result}</span>
                </p>
              ) : (
                <span class="hidden sm:block" aria-hidden="true"></span>
              )}
            </li>
          ))}
          {g.year === foundedYear && (
            <li class="grid grid-cols-1 gap-y-1.5 sm:items-center sm:gap-y-2 bg-navy px-5 py-5 text-white sm:grid-cols-[5.5rem_1fr_auto] sm:gap-x-6">
              <p class="font-display text-xs font-bold tracking-[0.15em]" lang="en">FOUNDED</p>
              <p class="font-bold">경성대학교 금융투자학회 KFEC 창립</p>
              <p class="mt-1 sm:mt-0">
                <span class="num inline-block border border-white px-3 py-1 text-sm font-bold">{site.founded}</span>
              </p>
            </li>
          )}
        </ul>
      </section>
    ))}
  </div>
)}
