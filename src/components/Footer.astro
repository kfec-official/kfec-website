---
import { url } from '../lib/utils';
import site from '../data/site.json';

const menu = [
  { label: 'ABOUT', ko: '학회 소개', href: '/about' },
  { label: 'RESEARCH', ko: '리서치', href: '/research' },
  { label: 'ACHIEVEMENTS', ko: '수상 · Alumni', href: '/awards' },
  { label: 'RECRUITMENT', ko: '가입 안내', href: '/join' },
];
---

<footer class="bg-ink text-on-navy on-dark">
  <div class="container-page grid gap-12 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <img
        src={url('/images/kfec-logo-white.png')}
        alt="KFEC Kyungsung Finance & Economics Club"
        width="311"
        height="100"
        class="h-14 w-auto"
        loading="lazy"
      />
      <p class="mt-6 text-sm font-bold text-white">{site.koreanName}</p>
      <p class="mt-1 text-sm">{site.affiliation}</p>
      <p class="num mt-1 text-sm"><span lang="en">Weekly Session</span> · {site.meeting}</p>
    </div>

    <nav aria-label="하단 메뉴">
      <p class="font-display text-xs font-bold tracking-[0.2em] text-white" lang="en">MENU</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        {menu.map((m) => (
          <li>
            <a href={url(m.href)} class="group grid grid-cols-[8.5rem_1fr] items-baseline hover:text-white">
              <span class="font-display text-xs font-bold tracking-[0.12em] text-white" lang="en">{m.label}</span>
              <span class="group-hover:underline underline-offset-4">{m.ko}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div>
      <p class="font-display text-xs font-bold tracking-[0.2em] text-white" lang="en">CONTACT</p>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li>
          <a href={site.cafeUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-white hover:underline underline-offset-4">
            <span lang="en">Naver Cafe</span><span class="sr-only"> (새 창)</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
          </a>
        </li>
        <li>
          <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 hover:text-white hover:underline underline-offset-4">
            Instagram {site.instagram}<span class="sr-only"> (새 창)</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div class="container-page flex flex-col gap-2 py-6 text-xs sm:flex-row sm:items-center sm:justify-between">
      <p>KFEC의 리서치 자료는 학습 목적의 참고 자료이며 투자 권유가 아닙니다.</p>
      <p class="num" lang="en">© 2026 KFEC. All rights reserved.</p>
    </div>
  </div>
</footer>
