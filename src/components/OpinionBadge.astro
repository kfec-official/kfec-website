---
interface Props {
  opinion?: string;
  tone?: 'navy' | 'light';
}
const { opinion, tone = 'navy' } = Astro.props;
---

{opinion && (
  <span
    class:list={[
      'inline-flex items-center border px-2 py-0.5 text-xs font-bold',
      tone === 'light' ? 'border-white text-white' : 'border-navy text-navy',
    ]}
  >
    <span class="sr-only">투자의견: </span>{opinion}
  </span>
)}
