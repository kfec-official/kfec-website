---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/utils';
---

<BaseLayout title="페이지를 찾을 수 없습니다" description="요청하신 페이지를 찾을 수 없습니다.">
  <section class="container-page py-24 text-center">
    <p class="num font-display text-6xl font-black text-navy">404</p>
    <h1 class="mt-4 font-serif text-2xl font-bold">페이지를 찾을 수 없습니다</h1>
    <p class="mt-3 text-muted">주소가 바뀌었거나 삭제된 페이지일 수 있습니다.</p>
    <a href={url('/')} class="btn-primary mt-8">홈으로 가기</a>
  </section>
</BaseLayout>
