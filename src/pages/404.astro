---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/utils';
---

<BaseLayout title="Page Not Found" description="요청하신 페이지를 찾을 수 없습니다.">
  <section class="container-page py-24 text-center">
    <p class="num font-display text-7xl font-black text-navy">404</p>
    <h1 lang="en" class="mt-4 font-display text-3xl font-bold">Page Not Found</h1>
    <p class="mt-3 text-muted">주소가 바뀌었거나 삭제된 페이지입니다.</p>
    <a href={url('/')} class="btn-primary mt-8">홈으로</a>
  </section>
</BaseLayout>
