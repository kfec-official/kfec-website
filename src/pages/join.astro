---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import site from '../data/site.json';

const requirements = ['신문 스크랩 10회', '기업 분석 보고서 1회', '교외 대회 1회', '강연 참여 1회'];
const process = [
  { title: '서류 지원', desc: '온라인 지원서 작성 및 제출' },
  { title: '대면 면접', desc: '지원자별 대면 면접 진행' },
  { title: '합격자 발표', desc: '개별 문자로 안내' },
];

const info = [
  { label: '가입 자격', value: '경성대학교 학생 누구나' },
  { label: '학회비', value: site.fee, note: site.feeExemption },
  { label: '정규 활동', value: site.meeting },
  { label: '활동 기간', value: '1년 이상 활동 필수', note: '수료를 위한 필수 조건' },
];
---

<BaseLayout
  title="Recruitment"
  description="KFEC 가입 자격, 학회비, 정규 활동 일정, 수료 기준 안내. 경성대학교 학생 누구나 지원할 수 있습니다."
>
  <PageHeader title="Recruitment" lead="경성대학교 학생이라면 전공·학년에 관계없이 누구나 함께할 수 있습니다." />

  <section class="container-page py-14 sm:py-20" aria-labelledby="info-title">
    <SectionHeading title="Information" id="info-title" />
    <dl class="mt-8 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
      {info.map((i) => (
        <div class="bg-white p-6 sm:p-7">
          <dt class="text-sm font-bold text-navy">{i.label}</dt>
          <dd class="mt-3">
            <span class="num block text-lg font-bold">{i.value}</span>
            {i.note && <span class="mt-1 block text-sm text-muted">{i.note}</span>}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="bg-white" aria-labelledby="process-title">
    <div class="container-page py-14 sm:py-20">
      <SectionHeading title="Process" desc="지원서 접수부터 합격자 발표까지 3단계로 진행됩니다." id="process-title" />
      <ol class="mt-8 grid gap-px border border-line bg-line md:grid-cols-3">
        {process.map((p, i) => (
          <li class="relative bg-white p-6 sm:p-7">
            <p class="font-display text-xs font-bold tracking-[0.15em] text-navy" lang="en">STEP</p>
            <p class="num mt-1 font-display text-3xl font-black text-navy" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-4 text-lg font-bold">{p.title}</h3>
            <p class="mt-1 text-sm text-muted">{p.desc}</p>
            {i < process.length - 1 && (
              <span aria-hidden="true" class="absolute top-1/2 -right-3.5 z-10 hidden h-7 w-7 -translate-y-1/2 items-center justify-center rounded-full border border-line bg-white text-sm text-navy md:flex">→</span>
            )}
          </li>
        ))}
      </ol>
      <p class="mt-5 flex items-start gap-2 text-sm text-muted">
        <svg class="mt-0.5 shrink-0 text-navy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" /></svg>
        <span>
          자세한 모집 일정과 지원 방법은
          <a href={site.cafeUrl} target="_blank" rel="noopener noreferrer" class="link font-medium">네이버 카페<span class="sr-only"> (새 창)</span></a>,
          <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer" class="link font-medium">인스타그램<span class="sr-only"> (새 창)</span></a>,
          <span class="font-medium text-ink">에브리타임</span>에 공지합니다.
        </span>
      </p>
    </div>
  </section>

  <section aria-labelledby="completion-title">
    <div class="container-page py-14 sm:py-20">
      <SectionHeading title="Completion" desc="1년 이상 활동하고, 아래 4가지 중 2가지 이상을 충족하면 수료합니다." id="completion-title" />
      <ol class="mt-8 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {requirements.map((r, i) => (
          <li class="bg-white p-6">
            <span class="num block font-display text-3xl font-black text-navy" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="mt-3 block font-bold">{r}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-navy text-white on-dark" aria-labelledby="contact-title">
    <div class="container-page flex flex-col gap-6 py-14 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 id="contact-title" lang="en" class="font-display text-3xl font-bold">Contact</h2>
        <p class="mt-2 text-on-navy">모집 일정과 지원 방법은 네이버 카페와 인스타그램 DM으로 안내합니다.</p>
      </div>
      <div class="flex shrink-0 flex-wrap gap-3">
        <a href={site.cafeUrl} target="_blank" rel="noopener noreferrer" class="btn-light">
          네이버 카페<span class="sr-only"> (새 창)</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
        </a>
        <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer" class="btn-outline-light">
          인스타그램 {site.instagram}<span class="sr-only"> (새 창)</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
