---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ReportCard from '../../components/ReportCard.astro';
import { getReports } from '../../lib/utils';

const reports = await getReports();
const filters = [
  { label: '전체', value: 'all' },
  { label: '기업분석', value: '기업분석' },
  { label: '산업분석', value: '산업분석' },
  { label: '경제분석', value: '경제분석' },
];
const count = (v: string) =>
  v === 'all' ? reports.length : reports.filter((r) => r.data.category === v).length;
---

<BaseLayout
  title="Research"
  description="KFEC 학회원이 직접 작성한 기업분석 · 산업분석 · 경제분석 보고서 목록입니다."
>
  <PageHeader title="Research" lead="학회원이 직접 작성한 기업분석 · 산업분석 · 경제분석 보고서입니다." />

  <section class="container-page py-12 sm:py-16" aria-label="보고서 목록">
    <div class="flex flex-wrap items-end justify-between gap-4 border-b border-line">
      <div role="group" aria-label="분류 필터" class="-mb-px flex gap-6" id="report-filters">
        {filters.map((f, i) => (
          <button
            type="button"
            data-filter={f.value}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="border-b-2 border-transparent pb-3 text-[0.9375rem] font-bold text-muted transition-colors hover:text-ink aria-pressed:border-navy aria-pressed:text-navy"
          >
            {f.label} <span class="num font-normal">{count(f.value)}</span>
          </button>
        ))}
      </div>
      <p class="pb-3 text-xs text-muted">최신 발행순</p>
    </div>

    <p class="sr-only" aria-live="polite" id="report-status"></p>

    {reports.length === 0 ? (
      <p class="py-16 text-center text-muted">등록된 보고서가 없습니다.</p>
    ) : (
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" id="report-list">
        {reports.map((r) => (
          <li data-category={r.data.category}>
            <ReportCard report={r} headingLevel="h2" />
          </li>
        ))}
      </ul>
    )}
    <p id="report-empty" class="hidden py-16 text-center text-muted">해당 분류의 보고서가 없습니다.</p>
  </section>
</BaseLayout>

<script>
  const group = document.getElementById('report-filters');
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('#report-list > li'));
  const status = document.getElementById('report-status');
  const empty = document.getElementById('report-empty');
  const buttons = Array.from(group?.querySelectorAll<HTMLButtonElement>('button[data-filter]') ?? []);

  function apply(value: string, updateUrl = true) {
    if (!buttons.some((b) => b.dataset.filter === value)) value = 'all';
    let shown = 0;
    for (const li of items) {
      const visible = value === 'all' || li.dataset.category === value;
      li.hidden = !visible;
      if (visible) shown++;
    }
    for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.filter === value));
    empty?.classList.toggle('hidden', shown > 0);
    if (status) status.textContent = `보고서 ${shown}건이 표시됩니다.`;
    if (updateUrl) {
      const u = new URL(window.location.href);
      if (value === 'all') u.searchParams.delete('category');
      else u.searchParams.set('category', value);
      history.replaceState(null, '', u);
    }
  }

  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter ?? 'all')));
  const initial = new URLSearchParams(window.location.search).get('category');
  if (initial) apply(initial, false);
</script>
