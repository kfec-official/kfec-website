---
import { render } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import OpinionBadge from '../../components/OpinionBadge.astro';
import { url, getReports, formatDate, isoDate, isPlaceholder } from '../../lib/utils';

export async function getStaticPaths() {
  const reports = await getReports();
  return reports.map((report) => ({ params: { slug: report.id }, props: { report } }));
}

const { report } = Astro.props;
const { title, category, date, summary, opinion, team, pdf } = report.data;
const { Content } = await render(report);
const iso = isoDate(date);
// PDF 찾기: ① pdf: 항목에 적은 파일 → ② 리포트 파일과 같은 이름의 PDF (예: 2026-11-20-cosmetics.pdf)
// 실제로 public/reports/ 에 있는 파일일 때만 다운로드 버튼을 보여 줍니다.
const reportsDir = path.join(process.cwd(), 'public', 'reports');
const existing = fs.existsSync(reportsDir) ? fs.readdirSync(reportsDir) : [];
const findPdf = (name: string) => existing.find((f) => f.toLowerCase() === name.toLowerCase());
const wanted = pdf && !isPlaceholder(pdf) ? pdf.replace(/^\/?(public\/)?(reports\/)?/, '').trim() : undefined;
const pdfFile = (wanted && findPdf(wanted)) || findPdf(`${report.id}.pdf`);
if (wanted && !findPdf(wanted)) {
  console.warn(`[리포트 ${report.id}] pdf: "${wanted}" 파일을 public/reports/ 에서 찾지 못했습니다.`);
}
const pdfHref = pdfFile ? url(`/reports/${encodeURIComponent(pdfFile)}`) : undefined;
---

<BaseLayout title={title} description={summary} type="article">
  <article>
    <header class="bg-navy text-white on-dark">
      <div class="container-page py-12 sm:py-16">
        <nav aria-label="현재 위치" class="font-display text-xs tracking-[0.12em] text-on-navy uppercase">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href={url('/')} class="hover:text-white hover:underline underline-offset-4">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href={url('/research')} class="hover:text-white hover:underline underline-offset-4">Research</a></li>
            <li aria-hidden="true">/</li>
            <li><span aria-current="page" class="font-sans tracking-normal">{category}</span></li>
          </ol>
        </nav>
        <p class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-on-navy">
          <span class="border border-white px-2 py-0.5 text-xs font-bold text-white">{category}</span>
          {iso ? <time class="num" datetime={iso}>{formatDate(date)}</time> : <span>{formatDate(date)}</span>}
          <span aria-hidden="true">·</span>
          <span>{team}</span>
        </p>
        <h1 class="mt-5 max-w-4xl font-serif text-[1.75rem] font-bold leading-snug sm:text-[2.5rem] sm:leading-tight">{title}</h1>
      </div>
    </header>

    <div class="container-page grid gap-10 py-10 sm:py-14 lg:grid-cols-[17rem_1fr] lg:gap-14">
      <aside aria-label="리포트 정보" class="lg:order-none">
        <div class="border border-line bg-white lg:sticky lg:top-24">
          <dl class="divide-y divide-line text-sm">
            <div class="flex items-center justify-between gap-4 px-5 py-4">
              <dt class="text-muted">투자의견</dt>
              <dd>{opinion ? <OpinionBadge opinion={opinion} /> : <span class="text-muted">—</span>}</dd>
            </div>
            <div class="flex items-center justify-between gap-4 px-5 py-4">
              <dt class="text-muted">발행일</dt>
              <dd class="num font-bold">{iso ? <time datetime={iso}>{formatDate(date)}</time> : formatDate(date)}</dd>
            </div>
            <div class="flex items-center justify-between gap-4 px-5 py-4">
              <dt class="text-muted">분류</dt>
              <dd class="font-bold">{category}</dd>
            </div>
            <div class="flex items-center justify-between gap-4 px-5 py-4">
              <dt class="text-muted">작성 팀</dt>
              <dd class="font-bold">{team}</dd>
            </div>
          </dl>
          <div class="space-y-2 border-t border-line p-5">
            {pdfHref ? (
              <a href={pdfHref} class="btn-primary w-full" download>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12m0 0l-5-5m5 5l5-5M5 21h14" /></svg>
                PDF 다운로드
              </a>
            ) : (
              <p class="border border-dashed border-line px-4 py-3 text-center text-sm text-muted">PDF 준비 중</p>
            )}
            <a href={url('/research')} class="btn-outline w-full">목록으로</a>
          </div>
        </div>
      </aside>

      <div class="min-w-0 max-w-3xl">
        <section aria-labelledby="summary-title" class="border-t-2 border-navy bg-white px-6 py-6 sm:px-8">
          <h2 id="summary-title" class="eyebrow" lang="en">Summary</h2>
          <p class="mt-3 font-serif text-lg font-bold leading-8 text-ink sm:text-xl sm:leading-9">{summary}</p>
        </section>
        <div class="prose-report mt-4">
          <Content />
        </div>
        <p class="mt-14 border-t border-line pt-6 text-xs text-muted">
          본 자료는 학습 목적의 참고 자료이며 투자 권유가 아닙니다.
        </p>
      </div>
    </div>
  </article>
</BaseLayout>
