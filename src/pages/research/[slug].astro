---
import { render } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import OpinionBadge from '../../components/OpinionBadge.astro';
import { url, getReports, formatDate, isoDate, isPlaceholder } from '../../lib/utils';

export async function getStaticPaths() {
  const reports = await getReports();
  return reports.map((report) => ({ params: { slug: report.id }, props: { report } }));
}

const { report } = Astro.props;
const { title, category, date, summary, opinion, team, pdf } = report.data;
const { Content } = await render(report);
const iso = isoDate(date);
// PDF 찾기: ① pdf: 항목에 적은 파일 → ② 리포트 파일과 같은 이름의 PDF (예: 2026-11-20-cosmetics.pdf)
// 실제로 public/reports/ 에 있는 파일일 때만 다운로드 버튼을 보여 줍니다.
const reportsDir = path.join(process.cwd(), 'public', 'reports');
const existing = fs.existsSync(reportsDir) ? fs.readdirSync(reportsDir) : [];
const findPdf = (name: string) => existing.find((f) => f.toLowerCase() === name.toLowerCase());
const wanted = pdf && !isPlaceholder(pdf) ? pdf.replace(/^\/?(public\/)?(reports\/)?/, '').trim() : undefined;
const pdfFile = (wanted && findPdf(wanted)) || findPdf(`${report.id}.pdf`);
if (wanted && !findPdf(wanted)) {
  console.warn(`[리포트 ${report.id}] pdf: "${wanted}" 파일을 public/reports/ 에서 찾지 못했습니다.`);
}
const pdfHref = pdfFile ? url(`/reports/${encodeURIComponent(pdfFile)}`) : undefined;
---

<BaseLayout title={title} description={summary} type="article">
  <article>
    <header class="border-b border-line bg-white">
      <div class="container-page max-w-4xl py-10 sm:py-14">
        <nav aria-label="현재 위치" class="text-sm text-muted">
          <ol class="flex flex-wrap items-center gap-2">
            <li><a href={url('/')} class="hover:text-navy hover:underline">홈</a></li>
            <li aria-hidden="true">/</li>
            <li><a href={url('/research')} class="hover:text-navy hover:underline">리서치</a></li>
            <li aria-hidden="true">/</li>
            <li><span aria-current="page">{category}</span></li>
          </ol>
        </nav>

        <p class="eyebrow mt-8">{category}</p>
        <h1 class="mt-3 font-serif text-2xl font-bold leading-snug sm:text-4xl">{title}</h1>

        <dl class="mt-8 grid grid-cols-2 gap-y-4 border-y border-line py-5 text-sm sm:grid-cols-4">
          <div>
            <dt class="text-muted">발행일</dt>
            <dd class="num mt-1 font-bold">
              {iso ? <time datetime={iso}>{formatDate(date)}</time> : formatDate(date)}
            </dd>
          </div>
          <div>
            <dt class="text-muted">분류</dt>
            <dd class="mt-1 font-bold">{category}</dd>
          </div>
          <div>
            <dt class="text-muted">작성 팀</dt>
            <dd class="mt-1 font-bold">{team}</dd>
          </div>
          {opinion && (
            <div>
              <dt class="text-muted">투자의견</dt>
              <dd class="mt-1"><OpinionBadge opinion={opinion} /></dd>
            </div>
          )}
        </dl>

        <p class="mt-8 border-l-4 border-navy bg-paper px-5 py-4 text-base leading-7 sm:text-lg">{summary}</p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          {pdfHref ? (
            <a href={pdfHref} class="btn-primary" download>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v12m0 0l-5-5m5 5l5-5M5 21h14" /></svg>
              PDF 다운로드
            </a>
          ) : (
            <p class="border border-dashed border-line px-4 py-3 text-sm text-muted">PDF 원문은 준비 중입니다.</p>
          )}
          <a href={url('/research')} class="btn-outline">목록으로</a>
        </div>
      </div>
    </header>

    <div class="container-page max-w-4xl py-10 sm:py-14">
      <div class="prose-report">
        <Content />
      </div>
      <p class="mt-14 border-t border-line pt-6 text-sm leading-6 text-muted">
        본 자료는 KFEC 학회원이 학습 목적으로 작성한 참고 자료이며, 특정 종목에 대한 투자 권유가 아닙니다.
        투자 판단과 그 결과에 대한 책임은 투자자 본인에게 있습니다.
      </p>
    </div>
  </article>
</BaseLayout>
