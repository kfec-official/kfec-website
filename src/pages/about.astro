---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import site from '../data/site.json';
import ActivityList from '../components/ActivityList.astro';
import { url } from '../lib/utils';

const facts = [
  { label: '학회명', value: `${site.koreanName} (${site.name})` },
  { label: '소속', value: site.affiliation },
  { label: '정규 활동', value: site.meeting },
  { label: '가입 자격', value: '경성대학교 학생 누구나' },
];


---

<BaseLayout
  title="About"
  description={`${site.koreanName} KFEC 소개. ${site.affiliation} 소속 금융투자학회입니다.`}
>
  <PageHeader title="About" lead={`${site.affiliation} 소속 금융투자학회`} />

  <section class="container-page py-14 sm:py-20" aria-labelledby="purpose-title">
    <SectionHeading title="Purpose" id="purpose-title" />
    <p class="mt-10 font-serif text-2xl font-bold text-ink sm:text-[1.75rem]">
      학문적 탐구와 실무 역량, 네트워크로 차세대 금융 인재를 양성합니다.
    </p>
    <dl class="mt-10 grid border-t border-line sm:grid-cols-2 lg:grid-cols-4">
      {facts.map((f) => (
        <div class="border-b border-line py-5 sm:pr-6">
          <dt class="text-sm font-bold text-navy">{f.label}</dt>
          <dd class="num mt-1.5 font-medium">{f.value}</dd>
        </div>
      ))}
    </dl>
    <a href={url('/join')} class="btn-primary mt-10">가입 안내 보기</a>
  </section>

  <section class="bg-white" aria-labelledby="activities-title">
    <div class="container-page py-14 sm:py-20">
      <SectionHeading title="What We Do" id="activities-title" />
      <div class="mt-10">
        <ActivityList />
      </div>
    </div>
  </section>
</BaseLayout>
