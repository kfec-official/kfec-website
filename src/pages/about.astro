---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import site from '../data/site.json';
import { url } from '../lib/utils';

const facts = [
  { label: 'Name', value: `${site.koreanName} (${site.name})` },
  { label: 'Affiliation', value: site.affiliation },
  { label: 'Weekly Session', value: site.meeting },
  { label: 'Eligibility', value: '경성대학교 학생 누구나' },
];

const pillars = [
  { no: '01', title: 'Research', desc: '기업분석·산업분석 보고서를 작성합니다.' },
  { no: '02', title: 'Competition', desc: '교내외 금융·경제 대회에 참가합니다.' },
  { no: '03', title: 'Network', desc: '교수진·현직 선배와 교류합니다.' },
];
---

<BaseLayout
  title="About"
  description={`${site.koreanName} KFEC 소개. ${site.affiliation} 소속 금융투자학회입니다.`}
>
  <PageHeader title="About" lead={`${site.affiliation} 소속 금융투자학회`} />

  <section class="container-page py-14 sm:py-20" aria-labelledby="purpose-title">
    <SectionHeading title="Purpose" id="purpose-title" />
    <div class="mt-10 grid gap-12 lg:grid-cols-[1.5fr_1fr] lg:gap-16">
      <div>
        <p lang="en" class="font-display text-2xl font-bold leading-snug text-ink sm:text-[2rem] sm:leading-tight">
          Building the next generation of finance professionals through academic inquiry, practical skills, and a
          network of faculty and alumni.
        </p>
        <p class="mt-6 text-base text-muted">학문적 탐구와 실무 역량, 교수진·현직 선배와의 네트워크로 차세대 금융 인재를 양성합니다.</p>
        <a href={url('/join')} class="btn-primary mt-10" lang="en">How to Join →</a>
      </div>
      <dl class="border-t border-line">
        {facts.map((f) => (
          <div class="border-b border-line py-4">
            <dt lang="en" class="font-display text-xs font-bold tracking-[0.15em] text-navy uppercase">{f.label}</dt>
            <dd class="num mt-1.5 font-medium">{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="bg-white" aria-labelledby="activities-title">
    <div class="container-page py-14 sm:py-20">
      <SectionHeading title="What We Do" id="activities-title" />
      <ul class="mt-10 grid gap-10 md:grid-cols-3 md:gap-8">
        {pillars.map((p) => (
          <li class="border-t-2 border-navy pt-5">
            <p class="num font-display text-4xl font-black text-navy">{p.no}</p>
            <h3 lang="en" class="mt-4 font-display text-2xl font-bold">{p.title}</h3>
            <p class="mt-2 text-sm text-muted">{p.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
