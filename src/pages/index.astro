---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ReportRow from '../components/ReportRow.astro';
import OpinionBadge from '../components/OpinionBadge.astro';
import AwardsByYear from '../components/AwardsByYear.astro';
import { url, getReports, getAwards, formatDate, isoDate } from '../lib/utils';
import site from '../data/site.json';

const allReports = await getReports();
const reports = allReports.slice(0, 3);
const latest = allReports[0];
const latestIso = latest ? isoDate(latest.data.date) : undefined;
const awards = getAwards().slice(0, 3);
---

<BaseLayout
  description="경성대학교 금융투자학회 KFEC 공식 홈페이지. 기업·산업 분석 리서치와 교내외 대회 활동으로 차세대 금융 전문 인재를 양성합니다."
>
  <!-- 히어로 -->
  <section class="bg-navy text-white on-dark" aria-labelledby="hero-title">
    <div class="container-page grid gap-12 py-16 sm:py-20 lg:grid-cols-[1.15fr_1fr] lg:items-end lg:gap-16 lg:py-24">
      <div>
        <img
          src={url('/images/kfec-logo-white.png')}
          alt="KFEC Kyungsung Finance & Economics Club"
          width="1244"
          height="400"
          class="h-auto w-full max-w-[17rem] sm:max-w-[21rem]"
          fetchpriority="high"
        />
        <h1 id="hero-title" lang="en" class="mt-12 font-display text-[2.75rem] font-bold leading-[1.1] sm:text-6xl lg:text-[4.25rem]">
          Read. Analyze.<br />Invest.
        </h1>
        <p class="mt-6 text-base text-on-navy sm:text-lg">읽고, 분석하고, 직접 운용합니다.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={url('/research')} class="btn-light" lang="en">View Research</a>
          <a href={url('/join')} class="btn-outline-light" lang="en">Join KFEC</a>
        </div>
      </div>

      {latest && (
        <aside aria-labelledby="latest-title" class="border border-white/25 bg-navy-dark p-6 sm:p-8">
          <div class="flex items-center justify-between gap-4 border-b border-white/20 pb-4">
            <p class="eyebrow-light" lang="en">Latest Research</p>
            <p class="text-xs text-on-navy">
              <span class="font-bold text-white">{latest.data.category}</span>
              <span aria-hidden="true"> · </span>
              {latestIso ? <time class="num" datetime={latestIso}>{formatDate(latest.data.date)}</time> : formatDate(latest.data.date)}
            </p>
          </div>
          <h2 id="latest-title" class="mt-6 font-serif text-xl font-bold leading-snug sm:text-2xl">
            <a href={url(`/research/${latest.id}/`)} class="hover:underline underline-offset-4">{latest.data.title}</a>
          </h2>
          <p class="mt-4 line-clamp-3 text-sm leading-7 text-on-navy">{latest.data.summary}</p>
          <div class="mt-7 flex items-center justify-between gap-4 border-t border-white/20 pt-5">
            <div class="flex items-center gap-3">
              <OpinionBadge opinion={latest.data.opinion} tone="light" />
              <span class="text-xs text-on-navy">{latest.data.team}</span>
            </div>
            <a href={url(`/research/${latest.id}/`)} class="text-sm font-bold text-white hover:underline underline-offset-4" aria-hidden="true" tabindex="-1">
              <span lang="en">Read Report →</span>
            </a>
          </div>
        </aside>
      )}
    </div>

    <div class="border-t border-white/15">
      <dl class="container-page grid divide-y divide-white/15 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
        <div class="py-5 sm:pr-8">
          <dt lang="en" class="font-display text-xs tracking-[0.12em] text-on-navy uppercase">Weekly Session</dt>
          <dd class="num mt-1 font-bold">{site.meeting}</dd>
        </div>
        <div class="py-5 sm:px-8">
          <dt lang="en" class="font-display text-xs tracking-[0.12em] text-on-navy uppercase">Eligibility</dt>
          <dd class="mt-1 font-bold">경성대학교 학생 누구나</dd>
        </div>
        <div class="py-5 sm:pl-8">
          <dt lang="en" class="font-display text-xs tracking-[0.12em] text-on-navy uppercase">Affiliation</dt>
          <dd class="mt-1 font-bold">{site.affiliation}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- 소개 -->
  <section class="bg-white" aria-labelledby="about-title">
    <div class="container-page py-16 md:py-20">
      <SectionHeading title="About KFEC" desc="학문적 탐구와 실무 역량, 네트워크로 차세대 금융 인재를 양성합니다." id="about-title" moreHref="/about" moreLabel="More" />
      <ul class="mt-10 grid gap-10 md:grid-cols-3 md:gap-8">
        {[
          { no: '01', title: 'Research', desc: '기업분석·산업분석 보고서 작성' },
          { no: '02', title: 'Competition', desc: '교내외 금융·경제 대회 참가' },
          { no: '03', title: 'Network', desc: '교수진·현직 선배와의 교류' },
        ].map((p) => (
          <li class="border-t-2 border-navy pt-5">
            <p class="num font-display text-3xl font-black text-navy">{p.no}</p>
            <h3 lang="en" class="mt-3 font-display text-2xl font-bold">{p.title}</h3>
            <p class="mt-1.5 text-sm text-muted">{p.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 최신 리서치 -->
  <section aria-labelledby="research-title">
    <div class="container-page py-16 md:py-20">
      <SectionHeading title="Latest Research" desc="학회원이 직접 작성한 기업분석·산업분석 보고서" id="research-title" moreHref="/research" />
      <ul class="mt-8 divide-y divide-line border border-line bg-white">
        {reports.map((r) => <li><ReportRow report={r} /></li>)}
      </ul>
    </div>
  </section>

  <!-- 최근 수상 -->
  <section class="bg-white" aria-labelledby="awards-title">
    <div class="container-page py-16 md:py-20">
      <SectionHeading title="Recent Awards" desc="교내외 금융·경제 대회 수상 내역" id="awards-title" moreHref="/awards" />
      <div class="mt-8">
        <AwardsByYear awards={awards} />
      </div>
    </div>
  </section>

  <!-- 가입 안내 -->
  <section class="bg-navy text-white" aria-labelledby="join-title">
    <div class="container-page flex flex-col gap-6 py-14 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 id="join-title" lang="en" class="font-display text-3xl font-bold">Join KFEC</h2>
        <p class="mt-2 text-on-navy">경성대학교 학생이라면 누구나 지원할 수 있습니다.</p>
      </div>
      <a href={url('/join')} class="btn-light shrink-0" lang="en">Recruitment →</a>
    </div>
  </section>
</BaseLayout>
