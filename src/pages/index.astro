---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ReportCard from '../components/ReportCard.astro';
import YeouidoSkyline from '../components/YeouidoSkyline.astro';
import AchievementsByYear from '../components/AchievementsByYear.astro';
import { url, getReports, getAchievementsByYear } from '../lib/utils';
import site from '../data/site.json';
import ActivityList from '../components/ActivityList.astro';

const reports = (await getReports()).slice(0, 3);
// 홈에는 가장 최근 연도만 표시
const latestAchievements = getAchievementsByYear().slice(0, 1);
---

<BaseLayout
  description="경성대학교 금융투자학회 KFEC 공식 홈페이지. 기업·산업 분석 리서치와 교내외 대회 활동으로 차세대 금융 전문 인재를 양성합니다."
>
  <!-- 히어로 -->
  <section class="overflow-hidden bg-navy text-white on-dark" aria-labelledby="hero-title">
    <div class="container-page grid gap-10 pt-16 sm:pt-20 lg:grid-cols-[1fr_1.05fr] lg:items-end lg:gap-12 lg:pt-24">
      <div class="lg:pb-24">
        <img
          src={url('/images/kfec-logo-white.png')}
          alt="KFEC Kyungsung Finance & Economics Club"
          width="1244"
          height="400"
          class="mx-auto h-auto w-full max-w-[17rem] sm:max-w-[21rem] lg:mx-0"
          fetchpriority="high"
        />
        <h1 id="hero-title" lang="en" class="mt-12 font-display text-[2.75rem] font-bold leading-[1.1] sm:text-6xl lg:text-[4.25rem]">
          Read. Analyze.<br />Invest.
        </h1>
        <p class="mt-6 text-base text-on-navy sm:text-lg">읽고, 분석하고, 직접 운용합니다.</p>
        <div class="mt-9 grid grid-cols-3 gap-2 sm:flex sm:flex-wrap sm:gap-3">
          <a href={url('/research')} class="btn-light px-2 whitespace-nowrap sm:px-5">리서치 보기</a>
          <a href={url('/awards')} class="btn-outline-light px-2 whitespace-nowrap sm:px-5">성과 보기</a>
          <a href={url('/join')} class="btn-outline-light px-2 whitespace-nowrap sm:px-5">가입 안내</a>
        </div>
      </div>

      <figure class="-mx-5 sm:mx-0 bleed-right">
        <YeouidoSkyline />
        <figcaption class="sr-only">여의도 금융가</figcaption>
      </figure>
    </div>

    <div class="border-t border-white/15">
      <dl class="container-page grid divide-y divide-white/15 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
        <div class="py-5 sm:pr-8">
          <dt class="text-xs text-on-navy">정규 활동</dt>
          <dd class="num mt-1 font-bold">{site.meeting}</dd>
        </div>
        <div class="py-5 sm:px-8">
          <dt class="text-xs text-on-navy">가입 자격</dt>
          <dd class="mt-1 font-bold">경성대학교 학생 누구나</dd>
        </div>
        <div class="py-5 sm:pl-8">
          <dt class="text-xs text-on-navy">소속</dt>
          <dd class="mt-1 font-bold">{site.affiliation}</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- 소개 -->
  <section class="bg-white" aria-labelledby="about-title">
    <div class="container-page py-16 md:py-20">
      <SectionHeading title="About KFEC" desc="학문적 탐구와 실무 역량, 네트워크로 차세대 금융 인재를 양성합니다." id="about-title" moreHref="/about" moreLabel="학회 소개" />
      <div class="mt-10">
        <ActivityList />
      </div>
    </div>
  </section>

  <!-- 최신 리서치 -->
  <section aria-labelledby="research-title">
    <div class="container-page py-16 md:py-20">
      <SectionHeading title="Latest Research" desc="학회원이 직접 작성한 기업분석 · 산업분석 · 경제분석 보고서" id="research-title" moreHref="/research" />
      <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {reports.map((r) => <li><ReportCard report={r} /></li>)}
      </ul>
    </div>
  </section>

  <!-- 최근 수상 -->
  <section class="bg-white" aria-labelledby="awards-title">
    <div class="container-page py-16 md:py-20">
      <SectionHeading title="Achievements" desc="공모전, 대외활동, 학회원의 진출 현황입니다." id="awards-title" moreHref="/awards" />
      <div class="mt-8">
        <AchievementsByYear groups={latestAchievements} />
      </div>
    </div>
  </section>

  <!-- 가입 안내 -->
  <section class="bg-navy text-white" aria-labelledby="join-title">
    <div class="container-page flex flex-col gap-6 py-14 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 id="join-title" lang="en" class="font-display text-3xl font-bold">Join KFEC</h2>
        <p class="mt-2 text-on-navy">경성대학교 학생이라면 누구나 지원할 수 있습니다.</p>
      </div>
      <a href={url('/join')} class="btn-light shrink-0">가입 안내 보기</a>
    </div>
  </section>
</BaseLayout>
