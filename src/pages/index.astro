---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ReportCard from '../components/ReportCard.astro';
import AwardsByYear from '../components/AwardsByYear.astro';
import AlumniTable from '../components/AlumniTable.astro';
import { url, getReports, getAwards, getAlumni } from '../lib/utils';
import site from '../data/site.json';

const reports = (await getReports()).slice(0, 3);
const awards = getAwards().slice(0, 3);
const alumni = getAlumni().slice(0, 3);
---

<BaseLayout
  description="경성대학교 금융투자학회 KFEC 공식 홈페이지. 기업·산업 분석 리서치와 교내외 대회 활동으로 차세대 금융 전문 인재를 양성합니다."
>
  <!-- 히어로 -->
  <section class="bg-navy text-white" aria-labelledby="hero-title">
    <div class="container-page py-16 sm:py-24">
      <img
        src={url('/images/kfec-logo-white.png')}
        alt="KFEC Kyungsung Finance & Economics Club"
        width="1244"
        height="400"
        class="h-auto w-full max-w-[22rem] sm:max-w-[28rem]"
        fetchpriority="high"
      />
      <h1 id="hero-title" class="mt-10 font-serif text-3xl font-bold leading-tight sm:text-5xl">
        읽고, 분석하고, 직접 운용합니다.
      </h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-on-navy sm:text-lg">
        {site.koreanName}는 경제·금융 분야의 학문적 탐구를 바탕으로 실무 역량을 키우는 학회입니다.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={url('/research')} class="btn-light">리서치 보기</a>
        <a href={url('/join')} class="btn-outline-light">가입 안내</a>
      </div>

      <dl class="mt-14 grid max-w-2xl gap-px border-t border-white/25 pt-6 sm:grid-cols-2">
        <div>
          <dt class="text-sm text-on-navy">정규 활동</dt>
          <dd class="num mt-1 text-xl font-bold">{site.meeting}</dd>
        </div>
        <div class="mt-5 sm:mt-0 sm:border-l sm:border-white/25 sm:pl-8">
          <dt class="text-sm text-on-navy">가입 자격</dt>
          <dd class="mt-1 text-xl font-bold">경성대학교 학생 누구나</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- 소개 -->
  <section class="bg-white" aria-labelledby="about-title">
    <div class="container-page grid gap-10 py-16 md:grid-cols-[1fr_1.4fr] md:py-20">
      <div>
        <p class="eyebrow">About KFEC</p>
        <h2 id="about-title" class="mt-2 font-serif text-2xl font-bold sm:text-[1.75rem]">
          학문적 탐구에서<br />실무 역량까지
        </h2>
      </div>
      <div>
        <p class="text-base leading-8 text-ink sm:text-lg">
          경제·금융 분야의 학문적 탐구를 바탕으로 실무 역량을 강화하고, 교수진·현직 선배와의 네트워크로
          차세대 금융 전문 인재를 양성합니다.
        </p>
        <ul class="mt-8 grid gap-px border border-line bg-line sm:grid-cols-3">
          <li class="bg-white p-5">
            <p class="font-display text-sm font-bold text-navy">01</p>
            <p class="mt-1 font-bold">리서치</p>
            <p class="mt-1 text-sm text-muted">기업·산업 분석 보고서</p>
          </li>
          <li class="bg-white p-5">
            <p class="font-display text-sm font-bold text-navy">02</p>
            <p class="mt-1 font-bold">대회 참가</p>
            <p class="mt-1 text-sm text-muted">교내외 금융·경제 대회</p>
          </li>
          <li class="bg-white p-5">
            <p class="font-display text-sm font-bold text-navy">03</p>
            <p class="mt-1 font-bold">네트워크</p>
            <p class="mt-1 text-sm text-muted">교수진·현직 선배와의 교류</p>
          </li>
        </ul>
        <a href={url('/about')} class="link mt-6 inline-block text-sm font-bold">학회 소개 자세히 보기</a>
      </div>
    </div>
  </section>

  <!-- 최신 리서치 -->
  <section aria-labelledby="research-title">
    <div class="container-page py-16 md:py-20">
      <SectionHeading eyebrow="Research" title="최신 리서치" id="research-title" moreHref="/research" />
      <ul class="mt-8 grid gap-5 md:grid-cols-3">
        {reports.map((r) => <li><ReportCard report={r} /></li>)}
      </ul>
    </div>
  </section>

  <!-- 최근 수상 -->
  <section class="bg-white" aria-labelledby="awards-title">
    <div class="container-page py-16 md:py-20">
      <SectionHeading eyebrow="Achievements" title="최근 수상 내역" id="awards-title" moreHref="/awards" />
      <div class="mt-8">
        <AwardsByYear awards={awards} />
      </div>
    </div>
  </section>

  <!-- Alumni·실습 현황 -->
  <section aria-labelledby="alumni-title">
    <div class="container-page py-16 md:py-20">
      <SectionHeading eyebrow="Alumni" title="Alumni·실습 현황" id="alumni-title" moreHref="/alumni" />
      <div class="mt-8">
        <AlumniTable list={alumni} caption="최근 Alumni·실습 현황 3건" />
      </div>
    </div>
  </section>

  <!-- 가입 안내 -->
  <section class="bg-navy text-white" aria-labelledby="join-title">
    <div class="container-page flex flex-col gap-6 py-14 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 id="join-title" class="font-serif text-2xl font-bold">함께 읽고 분석할 학회원을 찾습니다.</h2>
        <p class="mt-2 text-on-navy">경성대학교 학생이라면 누구나 지원할 수 있습니다.</p>
      </div>
      <a href={url('/join')} class="btn-light shrink-0">가입 안내 보기</a>
    </div>
  </section>
</BaseLayout>
