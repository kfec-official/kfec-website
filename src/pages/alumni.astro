---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import AlumniTable from '../components/AlumniTable.astro';
import { getAlumni, countAlumniByStatus } from '../lib/utils';

const list = getAlumni();
const counts = countAlumniByStatus(list);
---

<BaseLayout
  title="Alumni·실습 현황"
  description="KFEC 출신 Alumni의 진출 현황과 인턴·현장실습 중인 학회원 현황입니다."
>
  <PageHeader
    eyebrow="Alumni"
    title="Alumni·실습 현황"
    lead="KFEC를 거쳐 금융 현장으로 진출한 선배들과, 인턴·현장실습 중인 학회원들의 현황입니다."
  />
  <section class="container-page py-12 sm:py-16" aria-label="Alumni·실습 현황 표">
    {counts.length > 0 && (
      <dl class="mb-8 grid grid-cols-2 gap-3 sm:flex sm:flex-wrap">
        {counts.map((c) => (
          <div class="border border-line bg-white px-5 py-5 sm:min-w-44">
            <dt class="text-sm font-medium text-muted">{c.status}</dt>
            <dd class="num mt-1 font-display text-3xl font-bold text-navy">{c.count}<span class="ml-1 font-sans text-base text-ink">명</span></dd>
          </div>
        ))}
      </dl>
    )}
    <AlumniTable list={list} caption="Alumni·실습 현황 (최신순)" />
    <p class="mt-4 text-sm text-muted md:hidden">표가 화면보다 넓으면 좌우로 밀어서 볼 수 있습니다.</p>
  </section>
</BaseLayout>
