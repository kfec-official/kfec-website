---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import AchievementsByYear from '../components/AchievementsByYear.astro';
import { getAchievementsByYear } from '../lib/utils';

const groups = getAchievementsByYear();
---

<BaseLayout
  title="Achievements"
  description="KFEC 학회원들의 공모전, 대외활동, 진출 현황을 연도별로 정리했습니다."
>
  <PageHeader title="Achievements" lead="공모전, 대외활동, 학회원의 진출 현황입니다." />

  <section class="container-page py-14 sm:py-20" aria-label="연도별 Achievements">
    <AchievementsByYear groups={groups} headingLevel="h2" />
  </section>
</BaseLayout>
