---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import AwardsByYear from '../components/AwardsByYear.astro';
import { getAwards } from '../lib/utils';

const awards = getAwards();
---

<BaseLayout title="수상 내역" description="KFEC 학회원들의 교내외 금융·경제 대회 수상 내역입니다.">
  <PageHeader
    eyebrow="Achievements"
    title="수상 내역"
    lead="학회원들이 교내외 대회에서 거둔 성과입니다. 연도별로 정리했습니다."
  />
  <section class="container-page py-12 sm:py-16" aria-label="연도별 수상 내역">
    <AwardsByYear awards={awards} headingLevel="h2" />
  </section>
</BaseLayout>
