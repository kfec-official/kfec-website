---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AwardsByYear from '../components/AwardsByYear.astro';
import AlumniByYear from '../components/AlumniByYear.astro';
import { getAwards, getAlumni } from '../lib/utils';

const awards = getAwards();
const alumni = getAlumni();
---

<BaseLayout
  title="Achievements"
  description="KFEC 학회원들의 교내외 금융·경제 대회 수상 내역과 Alumni 진출·인턴·현장실습 현황입니다."
>
  <PageHeader title="Achievements" lead="교내외 대회 수상 내역과 Alumni 진출 현황입니다.">
    <nav aria-label="이 페이지 안 바로가기" class="mt-8">
      <ul class="flex flex-wrap gap-2" lang="en">
        <li><a href="#awards" class="btn-outline-light px-4 py-2">Awards</a></li>
        <li><a href="#alumni" class="btn-outline-light px-4 py-2">Alumni</a></li>
      </ul>
    </nav>
  </PageHeader>

  <section class="container-page py-14 sm:py-20" aria-labelledby="awards">
    <SectionHeading title="Awards" desc="교내외 금융·경제 대회 수상 내역" id="awards" />
    <div class="mt-10">
      <AwardsByYear awards={awards} />
    </div>
  </section>

  <section class="bg-white" aria-labelledby="alumni">
    <div class="container-page py-14 sm:py-20">
      <SectionHeading title="Alumni" desc="선배들의 진출처와 인턴·현장실습 현황" id="alumni" />
      <div class="mt-10">
        <AlumniByYear list={alumni} />
      </div>
    </div>
  </section>
</BaseLayout>
